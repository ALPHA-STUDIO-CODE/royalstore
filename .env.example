# Copy this file to .env (it is gitignored) and adjust the values.

# Runtime connection. Locally: your native PostgreSQL.
# Neon (Preview and Production, set in Vercel): the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/royal_store_dev

# Direct connection used by Prisma migrations.
# Neon: the NON-pooled connection string. Locally: the same as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/royal_store_dev

# A PostgreSQL server the integration tests may create and drop databases on.
# The database name in this URL is ignored; every test file gets its own temporary database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Public address of the site (used by the Origin check).
APP_BASE_URL=http://localhost:5173
