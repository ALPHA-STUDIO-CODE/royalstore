{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @royal-store/web build",
  "outputDirectory": "apps/web/dist",
  "regions": ["lhr1"],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  }
}
